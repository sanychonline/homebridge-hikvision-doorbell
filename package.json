{
  "name": "homebridge-hikvision-doorbell",
  "version": "0.1.13",
  "displayName": "Hikvision Doorbell",
  "description": "Homebridge video doorbell plugin for Hikvision DS-KB8112-IM with local RTSP video/audio, SDK-free talkback, motion-triggered HomeKit Secure Video, and a native HomeKit Doorbell service.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanychonline/homebridge-hikvision-doorbell.git"
  },
  "homepage": "https://github.com/sanychonline/homebridge-hikvision-doorbell#readme",
  "bugs": {
    "url": "https://github.com/sanychonline/homebridge-hikvision-doorbell/issues"
  },
  "main": "src/index.js",
  "files": [
    "config.schema.json",
    "src",
    "tools/hikvision-private-login-probe.js",
    "tools/hikvision-private-audio-start-probe.js",
    "tools/hikvision-private-voice-media-probe.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "node tools/check-no-sdk-binaries.js",
    "probe:hikvision-private-login": "node tools/hikvision-private-login-probe.js",
    "probe:hikvision-private-audio-start": "node tools/hikvision-private-audio-start-probe.js",
    "probe:hikvision-private-voice-media": "node tools/hikvision-private-voice-media-probe.js"
  },
  "keywords": [
    "homebridge-plugin",
    "hikvision",
    "hikvision-doorbell",
    "DS-KB8112-IM",
    "doorbell",
    "camera",
    "homekit-secure-video",
    "hksv",
    "rtsp"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "homebridge": "^2.0.0"
  },
  "peerDependencies": {
    "homebridge": ">=1.6.0"
  }
}
